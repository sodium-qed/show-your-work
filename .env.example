# Optional local AI model setting. Copy this file to .env to change it.
# Install Ollama 0.12.7 or later and run this command once in your terminal:
# ollama pull qwen3-vl:4b-instruct
# The app never downloads models automatically.
OLLAMA_MODEL=qwen3-vl:4b-instruct

# AI formatting is disabled when HOST is anything other than localhost.
HOST=localhost
PORT=4173
