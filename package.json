{
  "name": "show-your-work",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Turn highlighted textbook problems into a clean printable exam, entirely in the browser.",
  "engines": {
    "node": ">=22.3.0"
  },
  "scripts": {
    "start": "node scripts/serve.mjs",
    "build": "node scripts/build.mjs",
    "release:package": "npm run build && python3 scripts/package-release.py",
    "vendor": "node scripts/vendor.mjs",
    "sample": "node scripts/make-sample.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "node tests/e2e.mjs",
    "test:selection": "node tests/selection.e2e.mjs",
    "test:ocr": "node tests/ocr-recovery.e2e.mjs",
    "eval:agent": "node tests/agent.eval.mjs",
    "test:ranges": "node tests/range-selection.e2e.mjs",
    "test:scan": "node tests/scan-layout.e2e.mjs",
    "test:images": "node tests/pdf-images.e2e.mjs",
    "test:workspace": "node tests/workspace.e2e.mjs"
  },
  "dependencies": {
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "5.4.149"
  },
  "devDependencies": {
    "playwright": "1.56.1"
  }
}
