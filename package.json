{
  "name": "show-your-work",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Turn highlighted textbook problems into a clean printable exam, entirely in the browser.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node scripts/serve.mjs",
    "vendor": "node scripts/vendor.mjs",
    "sample": "node scripts/make-sample.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "node tests/e2e.mjs",
    "eval:agent": "node tests/agent.eval.mjs"
  },
  "dependencies": {
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "5.4.149"
  },
  "devDependencies": {
    "playwright": "1.56.1"
  }
}
