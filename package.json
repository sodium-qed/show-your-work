{
  "name": "show-your-work",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Browser math worksheet formatter with offline HTML and optional AI formatting through a local helper.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node scripts/serve.mjs",
    "dev": "node scripts/serve.mjs",
    "build": "node scripts/build.mjs",
    "preview": "node scripts/serve.mjs --dist",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "node tests/e2e.mjs",
    "build:html": "node scripts/build-html.mjs",
    "test:ui": "node tests/preferences-shortcuts.e2e.mjs",
    "test:text": "node tests/reflow-text.e2e.mjs",
    "test:ai": "node tests/ai-format.e2e.mjs"
  },
  "dependencies": {
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "5.4.149"
  },
  "devDependencies": {
    "playwright": "1.56.1"
  }
}
